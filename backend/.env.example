# SQLite is local and requires no setup.
DATABASE_URL=sqlite:///./incidents.db

# Optional: point these at your running Hindsight server.
HINDSIGHT_URL=http://127.0.0.1:8888
HINDSIGHT_BANK_ID=recallops
HINDSIGHT_ENABLED=false
HINDSIGHT_SEED_DEMO=false

# Comma-separated browser origins. For local Vite use this default.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
